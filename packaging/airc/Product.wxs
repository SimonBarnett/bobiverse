<?xml version="1.0" encoding="UTF-8"?>
<!--
  airc per-machine MSI (issue #305).
  Files harvested by heat.exe into HarvestedFiles.wxs (ComponentGroup AircFiles).
  Deferred CustomAction runs Install-Airc.cmd after InstallFiles (MSI already elevated).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="airc"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="SimonBarnett"
      UpgradeCode="B7E3C9A1-4F2D-4E8B-9C11-A1BC00A1C001">
    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Description="airc IRC shell service (FR #253 / #305)"
        Comments="Nick console-machine on #machine; silent in channel."
        Platform="x64" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of airc is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="MainFeature" Title="airc" Level="1">
      <ComponentGroupRef Id="AircFiles" />
      <ComponentRef Id="CmpInstallDirMark" />
    </Feature>

    <!-- Default install root C:\ai\airc (fleet convention). Avoid Id=WindowsVolume (ICE99). -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="INSTALLDIR" Name="airc" />
    </Directory>
    <SetDirectory Id="INSTALLDIR" Value="C:\ai\airc" />

    <!-- Distinct from agentic_irc airc-console CmpInstallDirMark (issue #12). -->
    <Component Id="CmpInstallDirMark" Directory="INSTALLDIR" Guid="A1C001D0-1D3F-4A5B-9C0D-00A1BC0A1C01">
      <CreateFolder />
      <RegistryValue
          Root="HKLM"
          Key="Software\SimonBarnett\bobiverse\airc"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLDIR]"
          KeyPath="yes" />
    </Component>

    <!--
      Quiet-exec Install-Airc.cmd from the installed tree.
      Requires WixUtilExtension (WixCA / CAQuietExec64 on x64).
      Issue #309: deferred CAQuietExec64 reads CustomActionData (property =
      deferred CA Id). QtExecCmdLine is immediate-only and yields 0x80070057.
    -->
    <CustomAction
        Id="SetAircInstallCmd"
        Property="RunAircInstall"
        Value="&quot;[INSTALLDIR]scripts\Install-Airc.cmd&quot;"
        Execute="immediate" />
    <CustomAction
        Id="RunAircInstall"
        BinaryKey="WixCA"
        DllEntry="CAQuietExec64"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <InstallExecuteSequence>
      <Custom Action="SetAircInstallCmd" After="InstallFiles">NOT Installed OR REINSTALL</Custom>
      <Custom Action="RunAircInstall" After="SetAircInstallCmd">NOT Installed OR REINSTALL</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
