{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "status",
  "type": "object",
  "required": ["sessionId", "kind", "state", "cwd", "title", "updatedAt"],
  "properties": {
    "sessionId": { "type": "string" },
    "kind": { "type": "string", "enum": ["oneshot", "live", "grokbot", "fleet"] },
    "state": { "type": "string" },
    "cwd": { "type": "string" },
    "title": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
